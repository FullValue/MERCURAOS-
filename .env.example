# Projet Supabase dédié à Mercura.
# Pooler transactionnel pour l'application, avec pool borné.
DATABASE_URL="postgresql://mercura_app.REF:VOTRE_MOT_DE_PASSE@HOTE_POOLER:6543/postgres?pgbouncer=true&schema=mercura&connection_limit=3&connect_timeout=5&pool_timeout=10"
# Connexion directe pour Prisma Migrate (port 5432).
DIRECT_URL="postgresql://mercura_app:VOTRE_MOT_DE_PASSE@db.REF.supabase.co:5432/postgres?schema=mercura"

# Supabase Auth : URL du même projet Mercura et clé publique anon/publishable.
NEXT_PUBLIC_SUPABASE_URL="https://REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="VOTRE_CLE_PUBLIQUE"

# Générer avec : openssl rand -base64 32
CHIFFREMENT_CLE="VOTRE_CLE_AES_256_BASE64"
# Secret HMAC du webhook de l'application Shopify Mercura.
SHOPIFY_WEBHOOK_SECRET="VOTRE_SECRET_WEBHOOK"
# URL publique exacte, sans slash final (http://localhost:3000 en local).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
